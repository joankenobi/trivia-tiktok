# Upstream tiktoklives_back read API (must be running locally)
TRIVIA_LIVES_API_BASE_URL=http://127.0.0.1:57785
TRIVIA_LIVES_API_TIMEOUT_S=10
TRIVIA_EVENTS_PAGE_LIMIT=200

# Poller cadence
TRIVIA_POLL_INTERVAL_S=0.9
TRIVIA_POLL_BACKOFF_MAX_S=2.0

# SQLite. Leave empty to use ./trivia_game.db
TRIVIA_DATABASE_URL=

# Avatar capture (signed CDN URLs expire, so bytes are saved while live)
TRIVIA_AVATAR_TIMEOUT_S=5

# TTS voice service: each new question's text is posted here to be read aloud
TRIVIA_TTS_API_BASE_URL=http://127.0.0.1:8081
TRIVIA_TTS_API_TIMEOUT_S=5

# Defaults for new shows
TRIVIA_QUESTION_TIME_LIMIT_S=10
TRIVIA_QUESTIONS_PER_SHOW=10
