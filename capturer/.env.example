# Target live (required)
TIKTOK_USERNAME=@your_live_account

# Optional proxies — only needed if your region/ISP blocks TikTok
TIKTOK_WEB_PROXY=
TIKTOK_WS_PROXY=

# Batching
BATCH_INTERVAL_SECONDS=2
BATCH_MAX_EVENTS=100

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Receiver. Empty endpoint and/or DRY_RUN=true => write JSONL to data/batches/
API_ENDPOINT=
DRY_RUN=true