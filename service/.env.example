# Database connection. Defaults to a local SQLite file; swap for Postgres later,
# e.g. postgresql+asyncpg://user:pass@host:5432/tiktoklives
DATABASE_URL=sqlite+aiosqlite:///./service.db

# Log level for the app
LOG_LEVEL=INFO
# Server bind address/port. Defaults to loopback: binding 0.0.0.0 exposes the
# unauthenticated batch intake endpoint (see README warning).
HOST=127.0.0.1
PORT=8000

# Request guards for the batch intake endpoint.
MAX_BATCH_EVENTS=500        # max events per batch payload (schema-enforced, 422)
MAX_PAYLOAD_BYTES=1000000   # max Content-Length for /api/* requests (413)
